<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fän Jaktlag - Säsongsplanering</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <style>
    [x-cloak] { display: none !important; }
  </style>
</head>
<body class="bg-stone-900 text-stone-100 min-h-screen font-sans">

  <div x-data="jaktApp()" class="max-w-4xl mx-auto pb-12">
    
    <!-- Header -->
    <header class="bg-emerald-950 border-b border-emerald-800 p-4 sticky top-0 z-10 shadow-md">
      <div class="flex justify-between items-center">
        <div>
          <h1 class="text-xl font-bold text-emerald-100">Fän Jaktlag</h1>
          <p class="text-xs text-emerald-400">Säsongsplanering & Loggbok</p>
        </div>
        <span class="bg-emerald-900 text-emerald-200 text-xs px-2.5 py-1 rounded-full border border-emerald-700">Säsong 2026/2027</span>
      </div>
    </header>

    <!-- Navigation Tabs -->
    <nav class="flex border-b border-stone-800 bg-stone-950 sticky top-[61px] z-10">
      <button @click="activeTab = 'schema'" :class="activeTab === 'schema' ? 'border-emerald-500 text-emerald-400 font-semibold' : 'border-transparent text-stone-400 hover:text-stone-200'" class="flex-1 py-3 text-sm text-center border-b-2 transition-colors">
        Jaktschema
      </button>
      <button @click="activeTab = 'deltagare'" :class="activeTab === 'deltagare' ? 'border-emerald-500 text-emerald-400 font-semibold' : 'border-transparent text-stone-400 hover:text-stone-200'" class="flex-1 py-3 text-sm text-center border-b-2 transition-colors">
        Deltagare & Hundar
      </button>
      <button @click="activeTab = 'rapporter'" :class="activeTab === 'rapporter' ? 'border-emerald-500 text-emerald-400 font-semibold' : 'border-transparent text-stone-400 hover:text-stone-200'" class="flex-1 py-3 text-sm text-center border-b-2 transition-colors">
        Jaktrapporter
      </button>
    </nav>

    <!-- Main Content Area -->
    <main class="p-4">

      <!-- FLIK 1: JAKTSCHEMA -->
      <section x-show="activeTab === 'schema'" x-cloak class="space-y-4">
        <div class="flex justify-between items-center">
          <h2 class="text-lg font-semibold text-stone-200">Planerade Jakttillfällen</h2>
          <button class="bg-emerald-700 hover:bg-emerald-600 text-white text-xs px-3 py-1.5 rounded-lg flex items-center gap-1 transition-colors">
            + Ny jakt
          </button>
        </div>

        <template x-for="jakt in jakter" :key="jakt.id">
          <div class="bg-stone-800/90 border border-stone-700/60 rounded-xl p-4 shadow-sm">
            <div class="flex justify-between items-start mb-2">
              <div>
                <span class="text-xs font-semibold text-emerald-400 uppercase tracking-wider" x-text="jakt.datum"></span>
                <h3 class="text-base font-bold text-white flex items-center gap-2">
                  <span x-text="jakt.mark"></span>
                  <template x-if="jakt.komplettering">
                    <span class="bg-amber-900/60 text-amber-300 text-xs px-2 py-0.5 rounded border border-amber-700/50" x-text="'+ ' + jakt.komplettering"></span>
                  </template>
                </h3>
              </div>
              <span :class="jakt.status === 'Planerad' ? 'bg-blue-950 text-blue-300 border-blue-800' : 'bg-stone-700 text-stone-300 border-stone-600'" class="text-xs px-2.5 py-1 rounded-full border" x-text="jakt.status"></span>
            </div>

            <!-- Mat & Logistik -->
            <div class="my-3 bg-stone-900/80 rounded-lg p-3 text-xs space-y-1.5 border border-stone-800">
              <div class="flex items-center gap-2 text-stone-300">
                <span class="font-semibold text-emerald-400">🍱 Lunch:</span>
                <span x-text="jakt.lunch.plan + ' (Ansvarig: ' + jakt.lunch.ansvarig + ')'"></span>
              </div>
              <div class="flex items-center gap-2 text-stone-300">
                <span class="font-semibold text-emerald-400">🍽️ Middag:</span>
                <span x-text="jakt.middag.planerad ? jakt.middag.detaljer : 'Ingen middag planerad'"></span>
              </div>
            </div>

            <!-- Deltagarlista med status -->
            <div>
              <h4 class="text-xs font-semibold text-stone-400 mb-2">Deltagarstatus:</h4>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                <template x-for="d in jakt.deltagare" :key="d.namn">
                  <div class="flex justify-between items-center bg-stone-900/40 px-2.5 py-1.5 rounded border border-stone-800 text-xs">
                    <span class="text-stone-200" x-text="d.namn"></span>
                    <span :class="{
                      'bg-emerald-900/80 text-emerald-300': d.status === 'Ja',
                      'bg-red-900/80 text-red-300': d.status === 'Nej',
                      'bg-amber-900/80 text-amber-300': d.status === 'Tillfrågad'
                    }" class="px-2 py-0.5 rounded text-[10px] font-medium" x-text="d.status"></span>
                  </div>
                </template>
              </div>
            </div>
          </div>
        </template>
      </section>

      <!-- FLIK 2: DELTAGARE & HUNDAR -->
      <section x-show="activeTab === 'deltagare'" x-cloak class="space-y-4">
        <div class="flex justify-between items-center">
          <h2 class="text-lg font-semibold text-stone-200">Jaktlag & Hundar</h2>
          <button class="bg-emerald-700 hover:bg-emerald-600 text-white text-xs px-3 py-1.5 rounded-lg flex items-center gap-1 transition-colors">
            + Lägg till deltagare
          </button>
        </div>

        <div class="grid grid-cols-1 gap-4">
          <template x-for="person in deltagareLista" :key="person.id">
            <div class="bg-stone-800/90 border border-stone-700/60 rounded-xl p-4 shadow-sm">
              <div class="flex justify-between items-start mb-2">
                <div>
                  <h3 class="text-base font-bold text-white" x-text="person.namn"></h3>
                  <p class="text-xs text-stone-400" x-text="person.telefon"></p>
                </div>
              </div>

              <!-- Roller -->
              <div class="flex flex-wrap gap-1.5 my-2">
                <template x-for="roll in person.roller" :key="roll">
                  <span class="bg-stone-700 text-stone-200 text-[11px] px-2 py-0.5 rounded-md border border-stone-600" x-text="roll"></span>
                </template>
              </div>

              <!-- Hundar -->
              <template x-if="person.hundar && person.hundar.length > 0">
                <div class="mt-3 border-t border-stone-700/50 pt-2">
                  <h4 class="text-xs font-semibold text-emerald-400 mb-1">🐕 Hundar:</h4>
                  <div class="space-y-1">
                    <template x-for="hund in person.hundar" :key="hund.namn">
                      <div class="bg-stone-900/60 p-2 rounded text-xs">
                        <div class="font-medium text-stone-200">
                          <span x-text="hund.namn"></span> 
                          <span class="text-stone-400 font-normal" x-text="'(' + hund.ras + ', f. ' + hund.foddYear + ')'"></span>
                        </div>
                        <p class="text-stone-400 text-[11px] mt-0.5" x-text="hund.kommentar"></p>
                      </div>
                    </template>
                  </div>
                </div>
              </template>
            </div>
          </template>
        </div>
      </section>

      <!-- FLIK 3: JAKTRAPPORTERING -->
      <section x-show="activeTab === 'rapporter'" x-cloak class="space-y-4">
        <div class="flex justify-between items-center">
          <h2 class="text-lg font-semibold text-stone-200">Genomförda Jakter & Loggbok</h2>
          <button class="bg-emerald-700 hover:bg-emerald-600 text-white text-xs px-3 py-1.5 rounded-lg flex items-center gap-1 transition-colors">
            + Ny rapport
          </button>
        </div>

        <template x-for="rapport in rapporter" :key="rapport.id">
          <div class="bg-stone-800/90 border border-stone-700/60 rounded-xl p-4 shadow-sm">
            <div class="flex justify-between items-center mb-2 border-b border-stone-700/50 pb-2">
              <div>
                <span class="text-xs font-semibold text-emerald-400 uppercase" x-text="rapport.datum"></span>
                <h3 class="text-base font-bold text-white" x-text="rapport.mark"></h3>
              </div>
              <template x-if="rapport.eftersok">
                <span class="bg-amber-950 text-amber-300 border border-amber-800 text-[11px] px-2 py-0.5 rounded-full font-medium">⚠️ Eftersök genomfört</span>
              </template>
            </div>

            <!-- Fällt vilt -->
            <div class="my-3">
              <h4 class="text-xs font-semibold text-stone-400 mb-1">Skjutet vilt:</h4>
              <div class="space-y-1">
                <template x-for="vilt in rapport.falltVilt" :key="vilt.art + vilt.pass">
                  <div class="flex justify-between text-xs bg-stone-900/60 px-3 py-1.5 rounded border border-stone-800">
                    <span class="text-emerald-300 font-medium" x-text="vilt.antal + 'x ' + vilt.art"></span>
                    <span class="text-stone-400" x-text="'Pass: ' + vilt.pass + ' (' + vilt.skytt + ')'"></span>
                  </div>
                </template>
              </div>
            </div>

            <!-- Observationer & Noteringar -->
            <div class="space-y-2 text-xs">
              <div class="bg-stone-900/40 p-2.5 rounded border border-stone-800">
                <span class="font-semibold text-stone-300 block mb-0.5">Viltobservationer:</span>
                <p class="text-stone-400" x-text="rapport.observationer"></p>
              </div>
              <template x-if="rapport.noteringar">
                <div class="bg-stone-900/40 p-2.5 rounded border border-stone-800">
                  <span class="font-semibold text-stone-300 block mb-0.5">Särskilda noteringar / Eftersök:</span>
                  <p class="text-stone-400" x-text="rapport.noteringar"></p>
                </div>
              </template>
            </div>
          </div>
        </template>
      </section>

    </main>
  </div>

